; Engine configuration file.
config_version=5

[application]

config/name="烈焰突袭"
config/description="移动、射击、必杀——短局竖屏动作"
config/version="2.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"

[autoload]

Sfx="*res://scripts/autoload/sfx.gd"
SaveData="*res://scripts/autoload/save_data.gd"
Bgm="*res://scripts/autoload/bgm.gd"
Haptics="*res://scripts/autoload/haptics.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_bullet"
2d_physics/layer_5="enemy_bullet"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.045, 0.08, 1)
